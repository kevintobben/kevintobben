---
import type { Project } from '../data/projects';

interface Props { project: Project; }
const { project } = Astro.props;
---

<article class="card">
  <div class="card__img">
    {project.image
      ? <img src={project.image} alt={project.title} loading="lazy" />
      : <span class="card__placeholder">{project.title}</span>
    }
  </div>

  <div class="card__body">
    <div class="card__tags">
      {project.tags.map(t => <span class="tag">{t}</span>)}
    </div>
    <h3 class="card__title">{project.title}</h3>
    <p class="card__desc">{project.description}</p>
    {project.url && (
      <a href={project.longDescription ? `/projecten/${project.slug}` : project.url}
           class="card__link"
           target={project.longDescription ? '_self' : '_blank'}
           rel={project.longDescription ? '' : 'noopener noreferrer'}
      >
        Bekijk project →
      </a>
    )}
  </div>
</article>

<style>
.card {
  background: var(--color-mid-green);
  border: 1px solid var(--color-border);
  border-radius: 1rem;
  overflow: hidden;
  transition: border-color 0.2s, transform 0.2s;
}
.card:hover {
  border-color: var(--color-accent);
  transform: translateY(-2px);
}

.card__img {
  aspect-ratio: 16/9;
  background: var(--color-text-muted);
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
}
.card__img img {
  width: 100%; height: 100%; object-fit: cover;
  transition: transform 0.4s ease;
}

.card:hover .card__img img { transform: scale(1.04); }

.card__placeholder {
  color: var(--color-text-muted);
  font-size: 0.9rem;
}

.card__body  { padding: 1.5rem; }

.card__tags  {
  display: flex;
  flex-wrap: wrap;
  gap: 0.4rem;
  margin-bottom: 0.75rem;
}

.tag {
  padding: 0.25rem 0.7rem;
  border: 1px solid var(--color-accent);
  border-radius: 2rem;
  font-size: 0.74rem;
  color: var(--color-text);
}

.card__title { font-size: 1.2rem; margin-bottom: 0.5rem; }
.card__desc  { font-size: 0.88rem; color: var(--color-text-muted); margin-bottom: 1rem; line-height: 1.6; height: 50px; }
.card__link  { font-size: 0.9rem; color: var(--color-accent); font-weight: 500; transition: opacity 0.2s; }
.card__link:hover { opacity: 0.7; }
</style>
