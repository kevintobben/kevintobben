---
import ProjectCard from '../ProjectCard.astro';
import { projects } from '../../data/projects';

const recent = projects.slice(0, 4);
---

<section class="recent" id="recente-projecten">
  <div class="container">

    <div class="recent__header">
      <div>
        <p class="section-label">Mijn werk</p>
        <h2 class="recent__title">
          Projecten die<br><span class="accent">spreken voor zich</span>
        </h2>
      </div>
      <a href="/projecten" class="btn btn-outline">Alle projecten →</a>
    </div>

    <div class="recent__grid">
      {recent.map(p => <ProjectCard project={p} />)}
    </div>
  </div>
</section>

<style>
.recent { padding: var(--section-gap) 0; }

.recent__header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-bottom: 3rem;
  flex-wrap: wrap;
}

.recent__title {
  font-size: clamp(2rem, 4vw, 3rem);
}

.recent__grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 4rem;
}

.recent__cta {
  text-align: center;
  padding-top: 3rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.recent__cta p { color: var(--color-text-muted); }

@media (max-width: 768px) { .recent__grid { grid-template-columns: 1fr; } }
</style>
