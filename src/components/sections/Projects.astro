---
import Card from "../ui/Card.astro";
import rentopbouw from "../../assets/project-images/project_rentopbouw.png";
---

<!-- Projects Section Container -->
<div class="projects-container mx-auto max-w-6xl">
  <!-- Projects Grid: Max 3 columns on desktop, 2 on tablet, 1 on mobile -->
  <div class="projects-grid grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 justify-center">
    <Card 
      title="Rentop Bouw"
      description="Een website voor Rentop Bouw met HTML en CSS"
      imageUrl={rentopbouw.src}
      pillTitle="Website"
    />
    <Card 
      title="Nutrinook (in ontwikkeling)"
      description="Een recepten website voor Nutrinook met React (Native) en Typescript"
      imageUrl={rentopbouw.src}
      pillTitle="Web & mobile app"
    />
    <Card 
      title="Budget buddy (in ontwikkeling)"
      description="Een budgettering webapplicatie voor Budget buddy met React en Typescript"
      imageUrl={rentopbouw.src}
      pillTitle="Web app"
    />
    <Card 
      title="Kledingkast organizer"
      description="Een web applicatie voor Kledingkast organizer met HTML, CSS en Javascript"
      imageUrl={rentopbouw.src}
      pillTitle="Web app"
    />
    <Card 
      title="Factuur maker"
      description="Een factuur maker tool met Astro en Javascript"
      imageUrl={rentopbouw.src}
      pillTitle="Web app"
    />
  </div>
</div>