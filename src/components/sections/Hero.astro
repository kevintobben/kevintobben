<section class="hero" id="home">
  <div class="container">
    <p class="section-label">Junior Frontend Developer</p>
    <h1 class="hero__title">
      Ik bouw snelle, toegankelijke website
    </h1>
    <p class="hero__desc">
      Ik creëer mooie en functionele websites met moderne technologieën.
      Ontdek mijn projecten en vaardigheden in webontwikkeling.
    </p>
    <div class="hero__actions">
      <a href="/projecten" class="btn btn-primary">Bekijk mijn werk →</a>
      <a href="/#contact"   class="btn btn-outline">Neem contact op</a>
    </div>
  </div>
</section>

<style>
.hero {
  min-height: 85svh;
  display: flex;
  align-items: center;
  position: relative;
  overflow: hidden;
}
.hero > .container {
  width: 100%;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: center;
}
.hero::before {
  content: '';
  position: absolute;
  top: -15%;
  right: -5%;
  width: 550px;
  height: 550px;
  background: radial-gradient(circle, rgba(69,125,88,0.18) 0%, transparent 70%);
  pointer-events: none;
}
.hero__title {
  font-size: clamp(3rem, 9vw, 4rem);
  font-weight: 800;
  margin-bottom: 1.5rem;
  max-width: 800px;
}
.hero__desc {
  font-size: 1rem;
  color: var(--color-text-muted);
  max-width: 485px;
  margin-bottom: 2.5rem;
}
.hero__actions {
  display: flex;
  gap: 1rem;
  flex-wrap: wrap;
}

@media (max-width: 768px) {
  .hero__title {
    font-size: 2rem;
  }
}
</style>
