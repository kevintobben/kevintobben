<section class="contact" id="contact">
  <div class="container">
    <div class="contact__inner">
      <p class="section-label">Contact</p>
      <h2 class="contact__title">
        Laten we<span class="accent"> kennismaken</span>
      </h2>
      <a href="mailto:kevintobben@outlook.com" class="btn btn-primary contact__btn">
        Stuur mij een e-mail →
      </a>
    </div>
  </div>
</section>

<style>
.contact { padding: var(--section-gap) 0; }

.contact__inner {
  text-align: center;
  max-width: 100%;
  margin: 0 auto;
}

.contact__title {
  text-align: left;
  font-size: clamp(2.5rem, 7vw, 4.5rem);
  margin-bottom: 1.25rem;
}

.contact__desc {
  color: var(--color-text-muted);
  font-size: 1.05rem;
  margin-bottom: 2.5rem;
}

.contact__btn {
  font-size: 1rem;
  padding: 1rem 2rem;
}
</style>
