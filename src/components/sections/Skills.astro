---
const categories = [
  {
    label: 'Frontend',
    skills: ['HTML', 'JavaScript', 'Astro.js', 'TypeScript', 'React', 'WordPress'],
  },
  {
    label: 'Styling',
    skills: ['CSS', 'Sass', 'Bootstrap', 'Tailwind CSS', 'Figma', 'Styled-Components'],
  },
  {
    label: 'Tools',
    skills: ['Git', 'Azure', 'Jest', 'React Testing Library', 'REST APIs'],
  },
];
---

<section class="skills" id="skills">
  <div class="container">
    <p class="section-label">Vaardigheden</p>
    <h2 class="skills__title">Mijn tech stack</h2>

    <div class="skills__grid">
      {categories.map(cat => (
        <div class="skill-cat">
          <h3 class="skill-cat__name">{cat.label}</h3>
          <div class="skill-cat__tags">
            {cat.skills.map(s => <span class="tag">{s}</span>)}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.skills {
  padding: var(--section-gap) 0;
}

.skills__title {
  font-size: clamp(2rem, 4vw, 3rem);
  margin-bottom: 3rem;
}

.skills__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.5rem;
}

.skill-cat {
  background: var(--color-mid-green);
  border: 1px solid var(--color-accent);
  border-radius: 1rem;
  padding: 2rem;
  transition: border-color 0.2s;
}
.skill-cat:hover { border-color: var(--color-cta); }

.skill-cat__name {
  font-size: 0.75rem;
  font-weight: 700;
  color: var(--color-bg);
  letter-spacing: 0.1em;
  text-transform: uppercase;
  margin-bottom: 1.25rem;
}

.skill-cat__tags {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.tag {
  padding: 0.35rem 0.85rem;
  background: var(--color-bg);
  border: 1px solid var(--color-mid-green);
  border-radius: 2rem;
  font-size: 0.83rem;
  color: var(--color-text-muted);
  transition: all 0.2s;
}
.tag:hover {
  background: rgba(210, 255, 170, 0.14);
  color: var(--color-text);
  border-color: rgba(210, 255, 170, 0.4);
}

@media (max-width: 900px) { .skills__grid { grid-template-columns: 1fr; } }
</style>
