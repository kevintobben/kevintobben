---
import Card from "../ui/SkillsCard.astro";
// Frontend Icons
import HtmlIcon from "../../assets/icons/html5.svg";
import JsIcon from "../../assets/icons/javascript.svg";
import TsIcon from "../../assets/icons/typescript.svg";
import ReactIcon from "../../assets/icons/react_dark.svg";
import AstroIcon from "../../assets/icons/astro-icon-light.svg";
//  Styling Icons
import CssIcon from "../../assets/icons/css.svg";
import SassIcon from "../../assets/icons/sass.svg";
import StyledComponentsIcon from "../../assets/icons/styledcomponents.svg";
import FigmaIcon from "../../assets/icons/figma.svg";
import TailwindIcon from "../../assets/icons/tailwindcss.svg";
import BootstrapIcon from "../../assets/icons/bootstrap.svg";
// Miscellaneous Icons
import GitIcon from "../../assets/icons/git.svg";
import AzureIcon from "../../assets/icons/azure.svg";
import JestIcon from "../../assets/icons/jest.svg";
import ReactTestingLibraryIcon from "../../assets/icons/reactrouter.svg";
import RestApiIcon from "../../assets/icons/fastapi.svg";
--- 
<div class="skills-container flex flex-col md:flex-col gap-8 md:gap-16 mb-16">
  <div class="frontend-container my-5 bg-white/10 backdrop-blur-md rounded-lg inset-shadow-sm inset-shadow-slate-300 p-6">
    <h3 class="text-2xl font-semibold underline underline-offset-4 decoration-indigo-600">Frontend</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <Card 
        title="HTML"
        imageUrl={HtmlIcon.src}
      />
      <Card 
        title="Javascript"
        imageUrl={JsIcon.src}
      />
      <Card 
        title="Typescript"
        imageUrl={TsIcon.src}
      />
      <Card 
        title="React"
        imageUrl={ReactIcon.src}
      />
      <Card 
        title="Astro.js"
        imageUrl={AstroIcon.src}
      />
    </div>
  </div>
  <div class="styling-container my-5 bg-white/10 backdrop-blur-md rounded-lg inset-shadow-sm inset-shadow-slate-300 p-6">
    <h3 class="text-2xl font-semibold underline underline-offset-4 decoration-indigo-600">Styling</h3>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      <Card 
        title="CSS"
        imageUrl={CssIcon.src}
      />
      <Card 
        title="Sass"
        imageUrl={SassIcon.src}
      />
      <Card 
        title="Styled-Components"
        imageUrl={StyledComponentsIcon.src}
      />
      <Card 
        title="Figma"
        imageUrl={FigmaIcon.src}
      />
      <Card 
        title="Tailwind CSS"
        imageUrl={TailwindIcon.src}
      />
      <Card 
        title="Bootstrap"
        imageUrl={BootstrapIcon.src}
      />
    </div>
  </div>
    <div class="tools-container mt-5 my-5 bg-white/10 backdrop-blur-md rounded-lg inset-shadow-sm inset-shadow-slate-300 p-6">
      <h3 class="text-2xl font-semibold underline underline-offset-4 decoration-indigo-600">Tools</h3>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        <Card 
          title="Git"
          imageUrl={GitIcon.src}
        />
        <Card 
          title="Azure"
          imageUrl={AzureIcon.src}
        />
        <Card 
          title="Jest"
          imageUrl={JestIcon.src}
        />
        <Card 
          title="React Testing Library"
          imageUrl={ReactTestingLibraryIcon.src}
        />
        <Card 
          title="REST APIs"
          imageUrl={RestApiIcon.src}
        />
      </div>
    </div>
</div>