---
interface Props {
	title: string;
	description?: string;
	imageUrl?: string;
}

const { title, description, imageUrl } = Astro.props;
---

<div class="bg-white/10 rounded-lg shadow-sm inset-shadow-white-200 overflow-hidden w-full max-w-sm mx-auto hover:shadow-md transition-shadow duration-300 mt-5 md:mt-10">
	{imageUrl && (
		<img 
			src={imageUrl} 
			alt={title}
			class="w-16 h-16 flex justify-center mx-auto mt-4"
		/>
	)}
	<div class="p-4 sm:p-6 lg:p-0 flex justify-center mx-auto mt-2 mb-4">
		<h3 class="text-xl sm:text-2xl font-bold text-gray-800">
			{title}
		</h3>
		<p class="text-sm sm:text-base text-gray-600 leading-relaxed">
			{description}
		</p>
	</div>
</div>