---
interface Props {
    title: string;
		description?: string;
    imageUrl?: string;
		pillTitle?: string;
}

const { title, description, imageUrl, pillTitle } = Astro.props;
---

<!-- Card Container: Rode border, rounded corners, shadow -->
<div class="project-card group rounded-lg border-4 border-purple-300 shadow-md overflow-hidden w-auto h-auto mx-auto hover:shadow-xl transition-shadow duration-300 mt-5 md:mt-10 relative mb-8">
    <div class="project-content">
			<div class="project-details absolute bottom-0 left-0 w-full h-full box-border bg-purple-100 text-center max-h-0 opacity-0 overflow-hidden p-1 transition-all duration-300 ease-in-out group-hover:max-h-full group-hover:opacity-100 flex flex-col justify-center align-center gap-4 px-6">
				<h3 class="project-tile text-black font-semibold">{title}</h3>
				<p class="project-description text-black">{description}</p>
				<a href="" class="project-link text-black"></a>
			</div>
			{imageUrl && (
					<!-- Image Wrapper: Vaste hoogte van 214px -->
					<div class="card-image-wrapper w-full h-[214px] bg-gray-100">
							<img
									src={imageUrl}
									alt={title}
									class="card-image w-full h-full object-cover"
							/>
					</div>
			)}
		</div>
    <!-- Title Pill: Gecentreerd op de onderste border -->
    <p class="project-title-pill absolute left-1/2 bottom-0 transform -translate-x-1/2 translate-y-1/2 bg-purple-300 px-6 py-2 rounded-full shadow-lg text-sm font-bold text-white whitespace-nowrap">
        {pillTitle}
    </p>
</div>

