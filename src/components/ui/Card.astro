---
interface Props {
	title: string;
	imageUrl?: string;
}

const { title, imageUrl } = Astro.props;
---

<div class="rounded-lg border-4 border-red-300 shadow-md overflow-hidden w-auto h-auto mx-auto hover:shadow-xl transition-shadow duration-300 mt-5 md:mt-10 relative">
	{imageUrl && (
		<div class="w-full h-[214px] bg-gray-100">
			<img
				src={imageUrl}
				alt={title}
				class="w-full h-full object-cover"
			/>
		</div>
	)}

	<!-- Title pill overlay bottom-center -->
	<div class="absolute left-1/2 transform -translate-x-1/2 -bottom-1 bg-white px-4 py-2 rounded-full shadow text-sm font-semibold text-gray-800">
		{title}
	</div>
</div>