---
interface Props {
	title: string;
	description?: string;
	imageUrl?: string;
}

const { title, description, imageUrl } = Astro.props;
---

<div class="bg-white rounded-lg shadow-md overflow-hidden w-full max-w-sm mx-auto hover:shadow-xl transition-shadow duration-300 mt-5 md:mt-10">
	{imageUrl && (
		<img 
			src={imageUrl} 
			alt={title}
			class="w-16 h-16 object-cover"
		/>
	)}
	<div class="p-4 sm:p-6">
		<h3 class="text-xl sm:text-2xl font-bold text-gray-800 mb-2">
			{title}
		</h3>
		<p class="text-sm sm:text-base text-gray-600 leading-relaxed">
			{description}
		</p>
	</div>
</div>