---
interface Props {
  title: string;
  description?: string;
  imageUrl?: string;
  pillTitle?: string;
}
const { title, description, imageUrl, pillTitle } = Astro.props;
---

<!-- Card Root: relative, géén overflow-hidden zodat de pill buiten de box zichtbaar is -->
<div class="project-card group relative mx-auto mt-5 md:mt-10 mb-10 w-full">

  <!-- Card Frame: border + rounding + clipping voor image/overlay -->
  <div class="card-frame relative rounded-lg border-4 border-slate-400 shadow-md overflow-hidden">
    {imageUrl && (
      <!-- Image -->
      <div class="card-image-wrapper w-full h-[214px] bg-gray-100">
        <img src={imageUrl} alt={title} class="card-image w-full h-full object-cover" />
      </div>
    )}

    <!-- Hover overlay -->
    <div class="project-details absolute inset-0 bottom-0 left-0 bg-violet-200 text-center max-h-0 opacity-0 overflow-hidden p-1 transition-all duration-300 ease-in-out group-hover:max-h-full group-hover:opacity-100 flex flex-col justify-center gap-4 px-6">
      <h3 class="project-title text-white font-semibold">{title}</h3>
      {description && <p class="project-description text-white/90">{description}</p>}
    </div>
  </div>

  <!-- Pill: exact midden, op de onderste border -->
  <p class="project-title-pill absolute left-1/2 bottom-0 -translate-x-1/2 translate-y-1/2 z-20 bg-slate-400 px-6 py-2 rounded-full shadow-lg text-sm font-bold text-white whitespace-nowrap">
    {pillTitle ?? title}
  </p>



