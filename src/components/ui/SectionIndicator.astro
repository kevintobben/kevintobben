---
interface Props {
	label?: string;
	level?: 1 | 2 | 3;
}

const { label, level = 2 } = Astro.props;
---

<div class="relative flex items-center gap-4 mb-8">
  <!-- Verticale lijn (links) -->
  <div class="flex flex-col items-center">
    <div class="w-px h-8 bg-gray-800"></div>
    <div class="w-3 h-3 rounded-full bg-gray-800 border-4 border-red-200"></div>
    <div class="w-px h-8 bg-gray-800"></div>
  </div>
  <!-- Label als heading, responsive -->
  {label && (
    level === 1 ? <h1 class="text-lg sm:text-xl font-bold text-gray-900">{label}</h1>
    : level === 2 ? <h2 class="text-base sm:text-lg font-bold text-gray-900">{label}</h2>
    : <h3 class="text-base font-semibold text-gray-900">{label}</h3>
  )}
</div>
