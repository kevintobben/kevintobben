---
interface Props {
  id?: string;
  bgImage?: string;
}

const { id, bgImage } = Astro.props;
---

<section class={`py-16 sm:py-20 relative`} id={id}>
  {bgImage && (
    <img 
      src={bgImage} 
      alt="" 
      fetchpriority="high" 
      class="absolute top-0 left-0 w-full h-full -z-10 blur-3xl object-cover"
    />
  )}
  
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 lg:pl-40">
    <div class="relative">
      <div class="section-container">
        <slot />
      </div>
    </div>
  </div>
</section>
