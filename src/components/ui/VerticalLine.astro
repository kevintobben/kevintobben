---
interface Props {
	class?: string;
}

const { class: className } = Astro.props;
---

<!-- Container met verticale lijn -->
<div class={`relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 ${className || ''}`}>
	<!-- Verticale lijn (links op desktop, gecentreerd op mobile) -->
	<div class="absolute left-16 sm:left-8 md:left-40 lg:left-140 top-0 bottom-0 w-px bg-gray-700 opacity-20 hidden sm:block"></div>
	
	<!-- Content -->
	<div class="relative">
		<slot />
	</div>
</div>
