---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';

export function getStaticPaths() {
    return projects
        .filter(p => p.longDescription) // alleen projecten MET detailpagina
        .map(p => ({
            params: { slug: p.slug },
            props: { project: p },
        }));
}

const { project } = Astro.props;
---

<Layout title={`${project.title} — Kevin Tobben`}>
    <section class="project-detail">
        <div class="container">

            <a href="/projecten" class="back">← Terug naar projecten</a>

            <div class="tags">
                {project.tags.map(t => <span class="tag">{t}</span>)}
            </div>

            <h1>{project.title}</h1>
            <p class="desc">{project.longDescription}</p>

            <div class="links">
                {project.url && <a href={project.url} target="_blank" class="btn btn-primary">Bekijk live →</a>}
                {project.github && <a href={project.github} target="_blank" class="btn btn-outline">GitHub →</a>}
            </div>

            {project.screenshots && (
                    <div class="screenshots">
                        {project.screenshots.map(src => (
                                <img src={src} alt={project.title} loading="lazy" />
                        ))}
                    </div>
            )}

        </div>
    </section>
</Layout>

<style>
    .project-detail {
        padding-top: 8rem;
        padding-bottom: var(--section-gap);
    }
    .back {
        display: inline-block;
        margin-bottom: 2rem;
        color: var(--color-text-muted);
        font-size: 0.9rem;
        transition: color 0.2s;
    }
    .back:hover { color: var(--color-accent); }

    h1 {
        font-size: clamp(2.5rem, 6vw, 4rem);
        margin: 1rem 0;
    }
    .desc {
        color: var(--color-text-muted);
        max-width: 680px;
        margin-bottom: 2rem;
    }
    .links { display: flex; gap: 1rem; margin-bottom: 3rem; }

    .tags { display: flex; flex-wrap: wrap; gap: 0.5rem; }
    .tag {
        padding: 0.25rem 0.7rem;
        border: 1px solid var(--color-border);
        border-radius: 2rem;
        font-size: 0.74rem;
        color: var(--color-text-muted);
    }

    .screenshots {
        display: flex;
        flex-direction: column;
        gap: 1.5rem;
    }
    .screenshots img {
        width: 100%;
        border-radius: 0.75rem;
        border: 1px solid var(--color-border);
    }
</style>