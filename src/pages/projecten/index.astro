---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/projects.ts';
---

<Layout
  title="Projecten — Kevin Tobben"
  description="Alle projecten van Kevin Tobben, frontend developer."
>
  <section class="projects-page">
    <div class="container">

      <p class="section-label">Mijn werk</p>
      <h1 class="page-title">
        Bekijk hier al<br>
        <span class="accent">mijn projecten.</span>
      </h1>

      <div class="grid">
        {projects.map(p => <ProjectCard project={p} />)}
      </div>

    </div>
  </section>
</Layout>

<style>
.projects-page {
  padding-top: 8rem;
  padding-bottom: var(--section-gap);
}

.page-title {
  font-size: clamp(3rem, 9vw, 5.5rem);
  margin-bottom: 4rem;
}

.grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1.5rem;
  margin-bottom: 5rem;
}

.page-cta {
  text-align: center;
  padding-top: 3rem;
  border-top: 1px solid var(--color-border);
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1rem;
}
.page-cta p { color: var(--color-text-muted); }

@media (max-width: 768px) { .grid { grid-template-columns: 1fr; } }
</style>
