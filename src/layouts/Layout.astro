---
import '../styles/global.css';
import background from '../assets/background.svg';
import background2 from '../assets/background2.svg';
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>kevintobben.nl</title>
	</head>
	<body class="relative">
		<img id="background2" src={background2.src} alt="" fetchpriority="high" class="fixed top-0 left-0 w-full h-full -z-1 blur-3xl"/>

		<!-- Verticale lijn door hele pagina, donker en responsive -->
		<!-- <div class="fixed md:left-32 lg:left-121 top-0 bottom-0 w-px bg-gray-800 opacity-40 pointer-events-none z-10"></div> -->
		
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>

<script src="https://cdn.jsdelivr.net/npm/flowbite@2.5.2/dist/flowbite.min.js"></script>